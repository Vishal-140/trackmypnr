# Copy to .env for local development. NEVER commit the real .env file.
# On Render, set these as dashboard Environment Variables instead (Section 12).

# --- Firebase ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Base64-encode your service account JSON: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to the above: mount the JSON via Render's "Secret Files" and point to it here.
# FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json

# --- PNR data source (RapidAPI) ---
# IMPORTANT: rotate any previously-exposed key before using it here (Section 5).
PNR_API_KEY=aa8dbd80bcmsh61cb2b517fa0b4cp16b9f3jsnd33bd65c41ae
PNR_API_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
PNR_API_TIMEOUT_SECONDS=8

# --- Cache ---
CACHE_TTL_SECONDS=120
CACHE_MAX_SIZE=2048

# --- CORS ---
ALLOWED_ORIGINS=https://trackmypnr.co.in,https://www.trackmypnr.co.in,http://localhost:3000

# --- Rate limiting ---
CHECK_RATE_LIMIT=10/minute
