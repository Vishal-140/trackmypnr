rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /trackedPnrs/{trackedPnrId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      match /history/{historyId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/trackedPnrs/$(trackedPnrId)).data.userId == request.auth.uid;
        // History snapshots are written by the backend via the Admin SDK,
        // which bypasses these rules — no client write access needed.
      }
    }
  }
}
